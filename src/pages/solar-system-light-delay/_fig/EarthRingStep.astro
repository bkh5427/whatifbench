---
/*
  ** 이 파일이 `---`로 시작하는 이유 **
  `<svg`나 주석으로 시작하는 `.astro`는 전송 중 콘텐츠 서명(C2PA)이 붙어
  +7,774바이트가 끼어들고 파일이 깨진다. 규약 §5 제작 표준.

  도해 2 — **메커니즘.** 반전 절에 놓는다.
  **위젯의 곡선·표를 다시 그리지 않는다** (규약 §5 금지 조항).
  위젯은 로그 축 위의 '분'을 그린다. 이것은 선형 au 축 위에서
  **지구 고리의 ±1.00 au가 두 줄 모두 같은 픽셀 폭**임을 그린다 —
  흔들림이 왜 안쪽 천체에서 크고 바깥쪽에서 사라지는지가 그 한 가지 사실에 있다.
  가로가 모자라므로 먼 줄에는 축 끊음(지그재그)을 넣는다.
*/
const W = 420;
const H = 312;

const AU_PX = 52;           // 1.00 au가 몇 픽셀인가. 두 줄이 같은 값을 쓴다.
const ORIGIN_X = 58;        // 태양(0 au)
const EARTH_AU = 1.0;       // 지구 고리의 반지름. 모든 줄에서 같은 걸음이다.

const ROW_1_Y = 106;
const ROW_2_Y = 228;
const HEAD_DY = -50;
const ARROW_DY = -19;
const TICK_H = 9;
const LABEL_DY = 24;
// 치수선 관례 — 화살표 위의 글자는 그 **구간의 길이**다. 고리 값(1.52 au)을 화살표
// 위에 두었더니 2.00 au 구간이 "1.52 au"로 읽혔다. 고리 값은 줄 제목으로 옮기고
// (눈금 밑은 양끝 값과 겹친다), 화살표 위에는 각 구간의 길이를 적는다.
const STEP_LABEL = `${EARTH_AU.toFixed(2)} au`;
const STEP_LABEL_GAP = 6;

// 먼 줄의 축 끊음. 이 구간에서 au 축이 압축된다.
const BREAK_FROM = 124;
const BREAK_TO = 168;
const NEPTUNE_X = 300;

const round = (value) => Number(value.toFixed(1));

/** 가까운 줄은 실제 축척 그대로. 먼 줄은 끊음 뒤부터 자리를 옮겨 그린다. */
const rows = [
  {
    key: 'mars',
    head: 'a ring just outside Earth’s — Mars',
    ringAu: '1.52 au',
    y: ROW_1_Y,
    axisFrom: ORIGIN_X,
    axisTo: round(ORIGIN_X + 2.9 * AU_PX),
    ringX: round(ORIGIN_X + 1.52371 * AU_PX),
    closestLabel: '0.52 au',
    farthestLabel: '2.52 au',
    broken: false,
  },
  {
    key: 'neptune',
    head: 'a ring far outside — Neptune',
    ringAu: '30.07 au',
    y: ROW_2_Y,
    axisFrom: ORIGIN_X,
    axisTo: round(NEPTUNE_X + 1.55 * AU_PX),
    ringX: NEPTUNE_X,
    closestLabel: '29.07 au',
    farthestLabel: '31.07 au',
    broken: true,
  },
].map((row) => ({
  ...row,
  closestX: round(row.ringX - EARTH_AU * AU_PX),
  farthestX: round(row.ringX + EARTH_AU * AU_PX),
}));

/** 양끝 화살표 하나. 좌표만 내고 그리기는 아래 마크업이 한다. */
function fig_arrow(fromX, toX, y) {
  const direction = toX > fromX ? 1 : -1;
  const cap = 5 * direction;
  return {
    line: `M ${fromX} ${y} L ${toX} ${y}`,
    head: `M ${toX} ${y} L ${toX - cap} ${y - 4} M ${toX} ${y} L ${toX - cap} ${y + 4}`,
  };
}
---
<svg
  class="fig-svg"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label="Two horizontal distance axes, both measured in astronomical units from the Sun and both drawn to the same scale. The upper axis is labelled a ring just outside Earth's, Mars, ring at 1.52 astronomical units, and carries a thick mark there. The lower axis is labelled a ring far outside, Neptune, ring at 30.07 astronomical units, and carries a thick mark there; the lower axis has a zigzag break in it because the distance will not fit on the page. On each axis an arrow of exactly the same width, one astronomical unit, runs to the left of the mark and another to the right of it. On the Mars axis those arrows reach ticks at 0.52 and 2.52 astronomical units, so the near end is a small fraction of the far end. On the Neptune axis the same two arrows reach ticks at 29.07 and 31.07 astronomical units, which are almost the same number. Each arrow is labelled 1.00 au. A note reads: each arrow is 1.00 au — Earth's own ring."
>
  <text x={W / 2} y="26" class="fig-label" text-anchor="middle">the same step, against two rings</text>

  {rows.map((row) => (
    <g>
      <text x={ORIGIN_X - 6} y={row.y + HEAD_DY} class="fig-label">{row.head}, ring at {row.ringAu}</text>

      <line x1={row.axisFrom} y1={row.y} x2={row.axisTo} y2={row.y} stroke="var(--rule)" stroke-width="2" />

      {row.broken && (
        <g>
          <line x1={BREAK_FROM} y1={row.y} x2={BREAK_TO} y2={row.y} stroke="var(--surface)" stroke-width="6" />
          <path
            d={`M ${BREAK_FROM} ${row.y + 7} L ${BREAK_FROM + 14} ${row.y - 7} L ${BREAK_FROM + 28} ${row.y + 7} L ${BREAK_TO} ${row.y - 7}`}
            fill="none"
            stroke="var(--graphite-soft)"
            stroke-width="1.8"
          />
          <text x={(BREAK_FROM + BREAK_TO) / 2} y={row.y + 26} class="fig-label-dim" text-anchor="middle">axis broken</text>
        </g>
      )}

      <circle cx={ORIGIN_X} cy={row.y} r="5" fill="var(--graphite)" />
      <text x={ORIGIN_X} y={row.y - 12} class="fig-label-dim" text-anchor="middle">Sun</text>

      <line x1={row.ringX} y1={row.y - 13} x2={row.ringX} y2={row.y + 13} stroke="var(--graphite)" stroke-width="3" />
      <text x={round((row.ringX + row.closestX) / 2)} y={row.y + ARROW_DY - STEP_LABEL_GAP} class="fig-label-dim" text-anchor="middle">{STEP_LABEL}</text>
      <text x={round((row.ringX + row.farthestX) / 2)} y={row.y + ARROW_DY - STEP_LABEL_GAP} class="fig-label-dim" text-anchor="middle">{STEP_LABEL}</text>

      <path d={fig_arrow(row.ringX, row.closestX, row.y + ARROW_DY).line} stroke="var(--graphite)" stroke-width="2" />
      <path d={fig_arrow(row.ringX, row.closestX, row.y + ARROW_DY).head} fill="none" stroke="var(--graphite)" stroke-width="2" />
      <path d={fig_arrow(row.ringX, row.farthestX, row.y + ARROW_DY).line} stroke="var(--graphite)" stroke-width="2" />
      <path d={fig_arrow(row.ringX, row.farthestX, row.y + ARROW_DY).head} fill="none" stroke="var(--graphite)" stroke-width="2" />

      <line x1={row.closestX} y1={row.y - TICK_H} x2={row.closestX} y2={row.y + TICK_H} stroke="var(--graphite-soft)" stroke-width="2" />
      <line x1={row.farthestX} y1={row.y - TICK_H} x2={row.farthestX} y2={row.y + TICK_H} stroke="var(--graphite-soft)" stroke-width="2" />

      <text x={row.closestX} y={row.y + LABEL_DY + 14} class="fig-value" text-anchor="middle">{row.closestLabel}</text>
      <text x={row.closestX} y={row.y + LABEL_DY + 32} class="fig-label-dim" text-anchor="middle">closest</text>
      <text x={row.farthestX} y={row.y + LABEL_DY + 14} class="fig-value" text-anchor="middle">{row.farthestLabel}</text>
      <text x={row.farthestX} y={row.y + LABEL_DY + 32} class="fig-label-dim" text-anchor="middle">farthest</text>
    </g>
  ))}

  <text x={W / 2} y={H - 10} class="fig-label" text-anchor="middle">each arrow is 1.00 au — Earth’s own ring</text>
</svg>
