---
/*
  ** 이 파일이 `---`로 시작하는 이유 **
  `<svg`나 주석으로 시작하는 `.astro`는 전송 중 콘텐츠 서명(C2PA)이 붙어 깨진다.
  프런트매터가 맨 앞에 있으면 붙지 않는다 (규약 §5 제작 표준).

  도해 1 — 설정. 위젯 **앞**에 놓는다 (규약 §5.5 S7).
  같은 사람 셋, 같은 창구 셋. 달라지는 것은 줄이 어디로 흐르는가뿐이다.
  **숫자 결과는 담지 않는다** — 그것은 위젯과 도해 2·3의 몫이다.

  ** 왜 가로 띠인가 (2026-09-20 개정) **
  처음에는 위·아래 두 칸의 세로형(420 × 360)으로 그렸고, 폰(390×844) 실측에서
  위젯 상단이 **1,467px**까지 내려갔다. 리드와 위젯 사이는 세로 예산이 가장 빡빡한
  자리다(규약 §1.5). 그래서 두 칸을 **좌우로** 눕히고 세로를 360 → 144로 줄였다.
  본문은 `<Figure variant="lede">`로 감싸 위아래 여백까지 좁힌다.
*/
const VIEW_W = 420;
const VIEW_H = 144;                      // 도입 삽화 표준에 맞춘 가로 띠

// 두 칸을 가르는 선.
const SPLIT_X = 207;
const SPLIT_TOP = 8;
const SPLIT_BOTTOM = 122;

const TITLE_Y = 18;
const DOT_R = 6;

// 창구. 두 칸이 **같은 높이**에 같은 크기로 놓인다 — 같은 창구라는 뜻이다.
const BOX_W = 36;
const BOX_H = 22;
// 4px 띄운다 — 붙여 놓으면 창구 셋이 칸 나뉜 상자 하나로 읽힌다(360px 실렌더).
const ROW_MIDS = [54, 80, 106];
const box_y = (mid) => mid - BOX_H / 2;

// 왼쪽 — 줄 하나가 세 창구를 먹인다.
const ONE_DOT_XS = [18, 36, 54];
const ONE_STEM_FROM = 66;
const ONE_FAN_X = 104;
const ONE_BOX_X = 150;

// 오른쪽 — 창구마다 자기 줄.
const MANY_TITLE_X = 218;
const MANY_DOT_X = 226;
const MANY_STEM_FROM = 238;
const MANY_BOX_X = 358;

const MID_ROW = ROW_MIDS[1];
const FOOT_Y = 136;
---
<svg
  class="fig-svg"
  viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
  role="img"
  aria-label="Two layouts of the same shop, drawn side by side. On the left, labelled one line, three customers drawn as dots stand in a single queue. One path leaves that queue and fans out to all three counters, drawn as open rectangles, so whoever is at the front takes whichever counter frees up first. On the right, labelled a line per counter, the same three customers stand in three separate queues of one. Each queue has its own path to its own counter and no path crosses to another counter. The counters and the customers are the same on both sides; only the routing differs."
>
  <text x="10" y={TITLE_Y} class="fig-label">One line</text>

  <g fill="var(--graphite-soft)">
    {ONE_DOT_XS.map((cx) => <circle cx={cx} cy={MID_ROW} r={DOT_R} />)}
  </g>
  <path
    d={`M${ONE_STEM_FROM},${MID_ROW} L${ONE_FAN_X},${MID_ROW}`}
    fill="none" stroke="var(--graphite-soft)" stroke-width="2"
  />
  {ROW_MIDS.map((mid) => (
    <path
      d={`M${ONE_FAN_X},${MID_ROW} C${ONE_FAN_X + 20},${MID_ROW} ${ONE_BOX_X - 20},${mid} ${ONE_BOX_X - 4},${mid}`}
      fill="none" stroke="var(--graphite-soft)" stroke-width="2"
    />
  ))}
  {ROW_MIDS.map((mid) => (
    <rect x={ONE_BOX_X} y={box_y(mid)} width={BOX_W} height={BOX_H} rx="2"
      fill="var(--surface)" stroke="var(--graphite)" stroke-width="2" />
  ))}

  <line x1={SPLIT_X} y1={SPLIT_TOP} x2={SPLIT_X} y2={SPLIT_BOTTOM} stroke="var(--rule)" stroke-width="1" />

  <text x={MANY_TITLE_X} y={TITLE_Y} class="fig-label">A line per counter</text>

  {ROW_MIDS.map((mid) => (
    <g>
      <circle cx={MANY_DOT_X} cy={mid} r={DOT_R} fill="var(--graphite-soft)" />
      <path
        d={`M${MANY_STEM_FROM},${mid} L${MANY_BOX_X - 4},${mid}`}
        fill="none" stroke="var(--graphite-soft)" stroke-width="2"
      />
      <rect x={MANY_BOX_X} y={box_y(mid)} width={BOX_W} height={BOX_H} rx="2"
        fill="var(--surface)" stroke="var(--graphite)" stroke-width="2" />
    </g>
  ))}

  <text x="10" y={FOOT_Y} class="fig-label-dim">three people, three counters, both sides</text>
</svg>
