---
import Base from "@layouts/Base.astro";
import { SITE_HEADLINE, SITE_SUBLINE } from "@data/site.js";
import { layout_read_sections } from "@data/layout.js";

// 무엇을 어떻게 묶을지는 이 페이지가 정하지 않는다 — `src/data/layout.js`가 정한다.
// 재배치는 그 파일 하나를 고치는 일이고, 글도 이 페이지도 건드리지 않는다.
const sections = layout_read_sections();
---

<Base
  title={null}
  description="Small interactive tools for questions where the arithmetic is easy and the answer still feels wrong."
>
  <section class="hero">
    <p class="kicker hero-kicker">Interactive workbench</p>
    <h1>{SITE_HEADLINE}</h1>
    <p>{SITE_SUBLINE}</p>
  </section>

  <p>
    I make small tools for questions where the arithmetic is short and the answer
    still feels wrong. You drag a slider, a chart moves, and you can watch the
    point where your intuition gives out.
  </p>

  <p>
    In 1990 a magazine column said switching doors wins two games in three.
    Thousands of letters told the columnist she was wrong. Watching ten thousand simulated games close in on 0.667 is a
    different experience. That is the whole idea.
  </p>

  {
    sections.map((section) => (
      <section class="home-cat">
        <h2><a href={section.href}>{section.name}</a></h2>
        <p class="section-lede">{section.lede}</p>
        {section.tools.length > 0 && (
          <div class="tool-grid">
            {section.tools.map((tool) => (
              <article class="tool-card">
                <div class="tool-body">
                  <h3><a href={`/${tool.slug}`}>{tool.name}</a></h3>
                  <p>{tool.blurb}</p>
                </div>
                {tool.figure && (
                  <p class="tool-figure">
                    <span class="tool-figure-value">{tool.figure.value}</span>{" "}
                    <span class="tool-figure-label">{tool.figure.label}</span>
                  </p>
                )}
              </article>
            ))}
          </div>
        )}
      </section>
    ))
  }

  <p class="note">
    Every tool has a written page under it: what the model assumes, and what it
    leaves out. I add them when they are finished, not on a schedule.
  </p>
</Base>
