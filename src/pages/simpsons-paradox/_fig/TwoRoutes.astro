---
/*
  ** 이 파일이 `---`로 시작하는 이유 **
  `<svg`로 시작하는 `.astro`는 전송 중 C2PA 서명이 붙어 깨진다. 규약 §5.

  도해 3 — 증명. 손계산 절에 놓는다.
  독립된 두 경로가 같은 답에서 만나는 그림(규약 §5). 왼쪽은 비율의 가중평균,
  오른쪽은 성공 건수의 정수 합. 둘은 서로가 계산한 값을 쓰지 않는다 —
  가중치는 왼쪽에만, 합산 건수는 오른쪽에만 있다. 겹치는 것은 입력과 합계뿐이다.

  **숫자는 지어내지 않는다.** 위젯이 쓰는 그 model.js를 여기서 불러 계산한다 —
  프리셋 표가 바뀌면 이 그림도 같이 바뀐다.
*/
import {
  model_calculate_preset_state,
  model_calculate_result,
} from "@widgets/simpsons-paradox/model.js";
// 백분율은 **위젯이 쓰는 그 표시 함수**가 찍는다 (본문 index.astro와 같은 자리).
import { display_format_percent } from "@widgets/simpsons-paradox/widget.js";

const PRESET_KEY = "berkeley";
const OPTION = "a"; // 남성 열. 본문 손계산이 따라가는 열과 같다.

const state = model_calculate_preset_state(PRESET_KEY);
const option = model_calculate_result(state).options[OPTION];

const count = (value) => Number(value).toLocaleString("en-US");
const dec = (value) => value.toFixed(4);
const pct = display_format_percent;

const group1 = option.groups[1];
const group2 = option.groups[2];
const weight = option.weight;

const W = 420;
const H = 334;

const BOX_Y = 42;
const BOX_H = 162;
const BOX_W = 194;
const LEFT_X = 10;
const RIGHT_X = 216;
const PAD_X = 12;
const TITLE_DY = 24;
const LINE_DY = [52, 74, 96, 118, 146];

const JOIN_Y = 228;
const RESULT_X = 100;
const RESULT_W = 220;
const RESULT_Y = 234;
const RESULT_H = 62;

const LEFT_MID = LEFT_X + BOX_W / 2;
const RIGHT_MID = RIGHT_X + BOX_W / 2;

const LEFT_LINES = [
  `w = ${count(group1.size)} / ${count(option.totalSize)}`,
  `= ${dec(weight)}`,
  `${dec(weight)} × ${dec(group1.rate)}`,
  `+ ${dec(1 - weight)} × ${dec(group2.rate)}`,
];
const RIGHT_LINES = [
  `${count(group1.success)} + ${count(group2.success)}`,
  `  = ${count(option.pooledSuccess)}`,
  `${count(group1.size)} + ${count(group2.size)}`,
  `  = ${count(option.totalSize)}`,
  `${count(option.pooledSuccess)} / ${count(option.totalSize)}`,
];
---
<svg
  class="fig-svg"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label={`Two independent routes to the same pooled figure for the men's column of the Berkeley preset. The left box, headed weighted average, divides ${count(group1.size)} by ${count(option.totalSize)} to get the weight ${dec(weight)}, then works out ${dec(weight)} times ${dec(group1.rate)} plus ${dec(1 - weight)} times ${dec(group2.rate)}. The right box, headed add the counts, adds ${count(group1.success)} and ${count(group2.success)} admissions to get ${count(option.pooledSuccess)}, and adds ${count(group1.size)} and ${count(group2.size)} applications to get ${count(option.totalSize)}, then divides the first by the second. The two boxes take different steps: the weight ${dec(weight)} appears only on the left, the combined ${count(option.pooledSuccess)} admissions only on the right. What they share is the ${count(group1.size)} applications and the total ${count(option.totalSize)}. Arrows from both boxes meet at one result, ${dec(option.pooledRate)}, which the bars show as ${pct(option.pooledRate)}.`}
>
  <text x={W / 2} y="24" class="fig-label" fill="var(--graphite)" text-anchor="middle">the men's column, two ways</text>

  <rect x={LEFT_X} y={BOX_Y} width={BOX_W} height={BOX_H} rx="3" fill="var(--surface)" stroke="var(--rule-strong)" stroke-width="1" />
  <text x={LEFT_X + PAD_X} y={BOX_Y + TITLE_DY} class="fig-label" fill="var(--graphite)">weighted average</text>
  {LEFT_LINES.map((line, index) => (
    <text x={LEFT_X + PAD_X} y={BOX_Y + LINE_DY[index]} class="fig-value" fill="var(--graphite)">{line}</text>
  ))}

  <rect x={RIGHT_X} y={BOX_Y} width={BOX_W} height={BOX_H} rx="3" fill="var(--surface)" stroke="var(--rule-strong)" stroke-width="1" />
  <text x={RIGHT_X + PAD_X} y={BOX_Y + TITLE_DY} class="fig-label" fill="var(--graphite)">add the counts</text>
  {RIGHT_LINES.map((line, index) => (
    <text x={RIGHT_X + PAD_X} y={BOX_Y + LINE_DY[index]} class="fig-value" fill="var(--graphite)">{line}</text>
  ))}

  <path
    d={`M${LEFT_MID},${BOX_Y + BOX_H} L${LEFT_MID},${JOIN_Y} L${W / 2},${JOIN_Y} L${W / 2},${RESULT_Y - 2}
        M${RIGHT_MID},${BOX_Y + BOX_H} L${RIGHT_MID},${JOIN_Y} L${W / 2},${JOIN_Y}
        M${W / 2 - 7},${RESULT_Y - 14} L${W / 2},${RESULT_Y - 2} L${W / 2 + 7},${RESULT_Y - 14}`}
    fill="none"
    stroke="var(--graphite-soft)"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <rect x={RESULT_X} y={RESULT_Y} width={RESULT_W} height={RESULT_H} rx="3" fill="var(--steel-100)" stroke="var(--steel-500)" stroke-width="2" />
  <text x={W / 2} y={RESULT_Y + 26} class="fig-num" fill="var(--graphite)" text-anchor="middle">{dec(option.pooledRate)}</text>
  <text x={W / 2} y={RESULT_Y + 48} class="fig-label-dim" fill="var(--graphite-soft)" text-anchor="middle">{`the bars read ${pct(option.pooledRate)}`}</text>

  <text x={W / 2} y={H - 8} class="fig-label" fill="var(--graphite)" text-anchor="middle">different steps, one answer</text>
</svg>
