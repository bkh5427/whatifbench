---
/*
  ** 이 파일이 `---`로 시작하는 이유 **
  `<svg`나 주석으로 시작하는 `.astro`는 전송 중 C2PA 서명이 붙어 파일이 깨진다.
  프런트매터가 맨 앞에 있으면 붙지 않는다. 규약 §5 제작 표준.

  도해 3 — 증명. 손계산 절에 둔다.
  상위 형태는 **독립된 두 경로가 같은 답에서 합류하는 그림**이다 (규약 §5).
  왼쪽은 리터만 세고, 오른쪽은 킬로줄만 센다. 오른쪽은 왼쪽의 답을 쓰지 않는다.
  두 경로가 같은 분에서 만난다.

  **숫자는 전부 model.js가 낸다.** 이 파일에는 숫자가 하나도 적혀 있지 않다 —
  적어 두면 모델이 바뀌었을 때 그림만 조용히 옛날 값을 말한다.
*/
import {
  SHOWER_FLOW_DEFAULT_LPM,
  SHOWER_MINUTES_DEFAULT,
  BATH_LITRES_DEFAULT,
  RISE_BATH_DEFAULT_K,
  WATER_DENSITY_KG_PER_LITRE,
  WATER_SPECIFIC_HEAT_KJ_PER_KG_K,
  model_calculate_water_volume,
  model_calculate_water_crossover,
} from "@widgets/shower-vs-bath/model.js";

const FLOW = SHOWER_FLOW_DEFAULT_LPM;
const MINUTES = SHOWER_MINUTES_DEFAULT;
const TUB = BATH_LITRES_DEFAULT;
const RISE = RISE_BATH_DEFAULT_K;

// ① 리터 경로
const showerLitres = model_calculate_water_volume(FLOW, MINUTES);
const shortLitres = TUB - showerLitres;
const extraByWater = shortLitres / FLOW;

// ② 킬로줄 경로 — ①의 결과를 쓰지 않는다
const kilojoules = (litres) => WATER_DENSITY_KG_PER_LITRE * litres * WATER_SPECIFIC_HEAT_KJ_PER_KG_K * RISE;
const showerKj = kilojoules(showerLitres);
const tubKj = kilojoules(TUB);
const shortKj = tubKj - showerKj;
const kjPerMinute = kilojoules(FLOW);
const extraByEnergy = shortKj / kjPerMinute;

// ③ 두 경로가 만나는 자리
const crossover = model_calculate_water_crossover(TUB, FLOW);
const seconds = Math.round((crossover - MINUTES) * 60);

// 표기. 위젯 화면과 같은 자릿수를 쓴다 (L 한 자리, 분 한 자리).
const litre = (value) => value.toFixed(1);
// 천 단위는 좁은 공백(U+202F) — 사이트 숫자 규약. 본문과 같은 표기.
const THOUSANDS_SEPARATOR = "\u202f";
const kj = (value) => Math.round(value).toLocaleString("en-US").replace(/,/g, THOUSANDS_SEPARATOR);
const minute = (value) => value.toFixed(2);
// 유량은 위젯 화면과 같이 소수 두 자리로 적는다 (`9.50 L/min`).
const flow = (value) => value.toFixed(2);

const W = 420;
const H = 408;
const COL_LEFT = 106;
const COL_RIGHT = 314;
const ROW_TOP = 92;
const ROW_GAP = 28;
const row = (i) => ROW_TOP + i * ROW_GAP;

const leftRows = [
  `${MINUTES} min → ${litre(showerLitres)} L`,
  `tub ${litre(TUB)} L`,
  `short ${litre(shortLitres)} L`,
  `${flow(FLOW)} L per min`,
  `${litre(shortLitres)} ÷ ${flow(FLOW)}`,
  `= ${minute(extraByWater)} min`,
];
const rightRows = [
  `${MINUTES} min → ${kj(showerKj)} kJ`,
  `tub ${kj(tubKj)} kJ`,
  `short ${kj(shortKj)} kJ`,
  `${kj(kjPerMinute)} kJ per min`,
  `${kj(shortKj)} ÷ ${kj(kjPerMinute)}`,
  `= ${minute(extraByEnergy)} min`,
];

const JOIN_TOP = row(5) + 16;
const JOIN_BOTTOM = JOIN_TOP + 42;
const NODE_W = 176;
const NODE_H = 52;
---
<svg
  class="fig-svg"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label={`Two independent routes to the same minute, drawn as two columns that join at the bottom. The left column counts litres only: ${MINUTES} minutes of shower is ${litre(showerLitres)} litres against a tub of ${litre(TUB)} litres, leaving it ${litre(shortLitres)} litres short, and at ${flow(FLOW)} litres a minute that gap takes ${minute(extraByWater)} of a minute to close. The right column counts kilojoules only and never uses the left column's answer: the same ${MINUTES} minutes is ${kj(showerKj)} kilojoules against the tub's ${kj(tubKj)}, leaving it ${kj(shortKj)} kilojoules short, and at ${kj(kjPerMinute)} kilojoules a minute that gap also takes ${minute(extraByEnergy)} of a minute. Two lines run down from the two columns and meet in one box, which reads ${MINUTES} minutes and ${seconds} seconds, or ${crossover.toFixed(1)} minutes.`}
>
  <text x={W / 2} y="28" class="fig-label" fill="var(--graphite)" text-anchor="middle">two routes to the same minute</text>

  <text x={COL_LEFT} y="60" class="fig-label" fill="var(--graphite)" text-anchor="middle">count litres</text>
  <text x={COL_RIGHT} y="60" class="fig-label" fill="var(--graphite)" text-anchor="middle">count kilojoules</text>
  <line x1="16" y1="70" x2={W / 2 - 8} y2="70" stroke="var(--rule-strong)" stroke-width="1" />
  <line x1={W / 2 + 8} y1="70" x2={W - 16} y2="70" stroke="var(--rule-strong)" stroke-width="1" />

  {leftRows.map((text, i) => (
    <text x={COL_LEFT} y={row(i)} class="fig-value" fill="var(--graphite)" text-anchor="middle">{text}</text>
  ))}
  {rightRows.map((text, i) => (
    <text x={COL_RIGHT} y={row(i)} class="fig-value" fill="var(--graphite)" text-anchor="middle">{text}</text>
  ))}

  <!-- 두 기둥 사이에 선을 긋지 않는다. 오른쪽은 왼쪽을 읽지 않는다 -->

  <!-- 합류 -->
  <path
    d={`M ${COL_LEFT} ${JOIN_TOP} L ${W / 2} ${JOIN_BOTTOM} M ${COL_RIGHT} ${JOIN_TOP} L ${W / 2} ${JOIN_BOTTOM}`}
    fill="none"
    stroke="var(--graphite)"
    stroke-width="2"
    stroke-linecap="round"
  />
  <rect
    x={W / 2 - NODE_W / 2}
    y={JOIN_BOTTOM}
    width={NODE_W}
    height={NODE_H}
    rx="1"
    fill="var(--surface)"
    stroke="var(--graphite)"
    stroke-width="2"
  />
  <text x={W / 2} y={JOIN_BOTTOM + 34} class="fig-num" fill="var(--graphite)" text-anchor="middle">{MINUTES} min {seconds} s</text>
  <text x={W / 2} y={JOIN_BOTTOM + NODE_H + 26} class="fig-value" fill="var(--graphite)" text-anchor="middle">= {crossover.toFixed(1)} min</text>
  <text x={W / 2} y={JOIN_BOTTOM + NODE_H + 48} class="fig-label-dim" fill="var(--graphite-soft)" text-anchor="middle">neither column used the other's answer</text>
</svg>
