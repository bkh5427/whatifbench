---
/**
 * 도해 1 — **설정.** 위젯 앞(리드 끝)에 놓는다. 규약 §5 표와 §5.5 S7.
 *
 * **가로 띠인 이유.** S7이 규칙 도해를 위젯 앞으로 옮기면서 이 자리가 §1.5의
 * 자리와 같아졌고, 그러니 §1.5의 치수가 여기에도 걸린다 — 가로형 짧은 띠.
 * 처음에는 세 단을 세로로 쌓아 420×404로 그렸는데, 폰(390×844) 실측에서
 * 위젯 상단이 1,571px까지 내려갔다(본보기 몬티홀 1,324). 도해 한 장이 433px을
 * 먹고 있었다. 가로로 눕히면 같은 세 가지를 112px에 담는다.
 *
 * 무엇을 재는 상황인가만 그린다. **숫자 결과는 없다** — 톱니 수도 기어인치도
 * 적지 않는다. 기호(C·S·D·L)도 쓰지 않는다: 규약 §6 "기호는 뒤로", 기호는
 * 수식 절에서 정의된다.
 *
 * `variant="lede"`를 주지 **않는다.** `.fig-lede`는 게이트의 도해 수에서
 * 빠지고(§5 "도입 삽화는 세지 않는다"), 이 편의 도해는 정확히 세 장이라
 * lede로 돌리면 2장이 되어 게이트가 막는다. 여백 차이는 19px뿐이고
 * 깊이를 줄인 것은 높이지 여백이 아니다.
 *
 * 도형은 원과 직선뿐이다. 사실적 실루엣 없음 (규약 §5, 저작권 위험 0).
 *
 * **이 파일이 `---`로 시작하는 이유**: `<svg`로 시작하는 `.astro`는 전송 중
 * C2PA 서명이 붙어 파일이 깨진다 (규약 §5).
 */

// ── 판 크기 — 가로형 짧은 띠 (규약 §1.5) ─────────────────────
const FIG_W = 420;
const FIG_H = 132;

// ── 칸 가르는 선 ───────────────────────────────────────────
const DIVIDER_X = [154, 282];
const DIVIDER_Y1 = 18;
const DIVIDER_Y2 = 100;

// ── 공통 세로 자리 ─────────────────────────────────────────
const ROW_CY = 58;
const LABEL_Y = 119;

// ── 1칸 · 앞뒤 톱니 ────────────────────────────────────────
const RING_CX = 52;
const RING_R = 26;
const COG_CX = 120;
const COG_R = 13;
const CHAIN_TOP = `M${RING_CX},${ROW_CY - RING_R} L${COG_CX},${ROW_CY - COG_R}`;
const CHAIN_BOTTOM = `M${RING_CX},${ROW_CY + RING_R} L${COG_CX},${ROW_CY + COG_R}`;
const CELL_A_LABEL_X = 82;

// ── 2칸 · 휠. 점선 안쪽 원이 림, 두 원 사이가 타이어 ─────────
const WHEEL_CX = 218;
const WHEEL_R_OUT = 32;
const WHEEL_R_RIM = 21;
const CELL_B_LABEL_X = WHEEL_CX;

// ── 3칸 · 크랭크 ───────────────────────────────────────────
const CRANK_X1 = 316;
const CRANK_X2 = 378;
const AXLE_R = 5;
const PEDAL_R = 6;
const CELL_C_LABEL_X = (CRANK_X1 + CRANK_X2) / 2;

// ── 선 굵기 ────────────────────────────────────────────────
const STROKE_SOLID = 2.5;
const STROKE_THIN = 2;
const DASH_RIM = "5 4";

const FIG_ALT =
  "A horizontal band split into three cells by two thin vertical rules. The " +
  "left cell holds a large circle and a small circle joined by two straight " +
  "lines standing for the chain, labelled front and back teeth. The middle " +
  "cell holds a circle with a second dashed circle inside it, labelled rim " +
  "plus tyre: the dashed inner circle is the rim and the ring between the two " +
  "circles is the tyre. The right cell holds a short straight line with a " +
  "small open ring at one end and a filled dot at the other, labelled the " +
  "crank. No numbers appear anywhere in the band.";
---

<svg class="fig-svg" viewBox={`0 0 ${FIG_W} ${FIG_H}`} role="img" aria-label={FIG_ALT}>
  {DIVIDER_X.map((x) => (
    <line x1={x} y1={DIVIDER_Y1} x2={x} y2={DIVIDER_Y2} stroke="var(--rule)" stroke-width="1" />
  ))}

  <!-- 1칸 — 앞 링과 뒤 스프라켓. 요지는 "둘 다 그냥 톱니 수"다 -->
  <path d={CHAIN_TOP} stroke="var(--graphite-soft)" stroke-width={STROKE_THIN} fill="none" />
  <path d={CHAIN_BOTTOM} stroke="var(--graphite-soft)" stroke-width={STROKE_THIN} fill="none" />
  <circle cx={RING_CX} cy={ROW_CY} r={RING_R}
          fill="var(--surface)" stroke="var(--graphite)" stroke-width={STROKE_SOLID} />
  <circle cx={COG_CX} cy={ROW_CY} r={COG_R}
          fill="var(--surface)" stroke="var(--graphite)" stroke-width={STROKE_SOLID} />
  <text x={CELL_A_LABEL_X} y={LABEL_Y} class="fig-label-dim" text-anchor="middle">front and back teeth</text>

  <!-- 2칸 — 휠 -->
  <circle cx={WHEEL_CX} cy={ROW_CY} r={WHEEL_R_OUT}
          fill="var(--surface)" stroke="var(--graphite)" stroke-width={STROKE_SOLID} />
  <circle cx={WHEEL_CX} cy={ROW_CY} r={WHEEL_R_RIM}
          fill="var(--paper-sunk)" stroke="var(--steel-700)" stroke-width={STROKE_THIN}
          stroke-dasharray={DASH_RIM} />
  <text x={CELL_B_LABEL_X} y={LABEL_Y} class="fig-label-dim" text-anchor="middle">rim plus tyre</text>

  <!-- 3칸 — 크랭크. 선 하나와 점 하나로 끝낸다 -->
  <line x1={CRANK_X1} y1={ROW_CY} x2={CRANK_X2} y2={ROW_CY}
        stroke="var(--graphite)" stroke-width="4" stroke-linecap="round" />
  <circle cx={CRANK_X1} cy={ROW_CY} r={AXLE_R}
          fill="var(--surface)" stroke="var(--graphite)" stroke-width={STROKE_THIN} />
  <circle cx={CRANK_X2} cy={ROW_CY} r={PEDAL_R} fill="var(--graphite)" />
  <text x={CELL_C_LABEL_X} y={LABEL_Y} class="fig-label-dim" text-anchor="middle">the crank</text>
</svg>
