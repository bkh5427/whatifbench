---
/**
 * 도해 1 — 설정. **위젯 앞**에 놓는다 (규약 §5.5 S7).
 *
 * 그리는 것: 이 모델이 재는 상황. 한 도로를 두 번 달리고, 두 번 다 같은 만큼
 * 서 있는다. 숫자 결과는 한 자리도 담지 않는다 — 결과를 보는 곳은 위젯이다.
 *
 * **가로형 짧은 띠다 (규약 §1.5, 세로 150 이하).** 이 자리는 세로 예산이 가장
 * 빡빡하다 — 위젯 앞 도해 한 장의 높이가 위젯 상단 깊이의 차이를 거의 전부
 * 만든다(폰 390×844 실측). 그래서 넷을 세로로 쌓지 않고 **왼쪽 난간에 그림,
 * 오른쪽 기둥에 이름**으로 눕혔다. 처음에는 세로 204로 그렸다가 게이트에 걸렸다.
 *
 * 글자는 **위젯 화면의 슬라이더 라벨을 그대로** 쓴다 (규약 §5.5 S1).
 * 두 달리기는 색이 아니라 **화살표 길이와 글자**로 구분한다 (색각 대비).
 * 서 있는 시간은 위젯 막대와 같은 **빗금**으로 표시해 둘이 같은 것임을 잇는다.
 */

// ── 판 크기 — 가로 띠 ──────────────────────────────────────
const FIG_W = 420;
const FIG_H = 146;

// ── 왼쪽 난간(그림)과 오른쪽 기둥(이름) ────────────────────
const RAIL_X = 16;
const LABEL_X = 164;

// ── 제목 ───────────────────────────────────────────────────
const TITLE_Y = 16;

// ── 도로 — 두 달리기가 같은 길을 쓴다 ──────────────────────
const ROAD_X2 = 150;
const ROAD_Y = 40;
const ROAD_TICK_H = 6;
const ROAD_LABEL_Y = 45;

// ── 두 달리기. 화살표 길이가 속도다 ────────────────────────
const RUN_SLOW = { x2: 64, y: 70, labelY: 75 };
const RUN_FAST = { x2: 120, y: 96, labelY: 101 };
const ARROW_HEAD = 6;

// ── 서 있는 시간 ───────────────────────────────────────────
const STOP_Y = 118;
const STOP_W = 36;
const STOP_H = 16;
const STOP_TEXT_X = 62;
const STOP_TEXT_Y = 131;
const STOP_NOTE_X = 252;

const FIG_ALT =
  "The situation the model measures, drawn as one wide band. A line with a tick " +
  "at each end stands for the road, labelled How far you are going; both runs " +
  "use that one road. Under it are two arrows that start at the same point. The " +
  "short arrow is labelled The speed you were doing. The longer arrow is " +
  "labelled The speed you raise it to. At the foot of the band a hatched block " +
  "stands for the Minutes stuck not moving, and it is the same on both runs. " +
  "No result is shown.";
---

<svg class="fig-svg" viewBox={`0 0 ${FIG_W} ${FIG_H}`} role="img" aria-label={FIG_ALT}>
  <defs>
    <pattern id="setup-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="8" height="8" fill="var(--surface)" />
      <rect width="4" height="8" fill="var(--series-2)" />
    </pattern>
  </defs>

  <text x={RAIL_X} y={TITLE_Y} class="fig-label" fill="var(--graphite)">one road, driven twice</text>

  <!-- 도로 — 같은 거리를 두 번 간다 -->
  <line x1={RAIL_X} y1={ROAD_Y} x2={ROAD_X2} y2={ROAD_Y} stroke="var(--graphite)" stroke-width="2" />
  <line x1={RAIL_X} y1={ROAD_Y - ROAD_TICK_H} x2={RAIL_X} y2={ROAD_Y + ROAD_TICK_H} stroke="var(--graphite)" stroke-width="2" />
  <line x1={ROAD_X2} y1={ROAD_Y - ROAD_TICK_H} x2={ROAD_X2} y2={ROAD_Y + ROAD_TICK_H} stroke="var(--graphite)" stroke-width="2" />
  <text x={LABEL_X} y={ROAD_LABEL_Y} class="fig-label-dim" fill="var(--graphite-soft)">How far you are going</text>

  <!-- 원래 속도 — 짧은 화살표 -->
  <line x1={RAIL_X} y1={RUN_SLOW.y} x2={RUN_SLOW.x2} y2={RUN_SLOW.y} stroke="var(--graphite)" stroke-width="2.5" />
  <path
    d={`M${RUN_SLOW.x2 - ARROW_HEAD},${RUN_SLOW.y - ARROW_HEAD} L${RUN_SLOW.x2},${RUN_SLOW.y} L${RUN_SLOW.x2 - ARROW_HEAD},${RUN_SLOW.y + ARROW_HEAD}`}
    fill="none" stroke="var(--graphite)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
  />
  <text x={LABEL_X} y={RUN_SLOW.labelY} class="fig-label" fill="var(--graphite)">The speed you were doing</text>

  <!-- 올린 속도 — 긴 화살표 -->
  <line x1={RAIL_X} y1={RUN_FAST.y} x2={RUN_FAST.x2} y2={RUN_FAST.y} stroke="var(--series-1)" stroke-width="2.5" />
  <path
    d={`M${RUN_FAST.x2 - ARROW_HEAD},${RUN_FAST.y - ARROW_HEAD} L${RUN_FAST.x2},${RUN_FAST.y} L${RUN_FAST.x2 - ARROW_HEAD},${RUN_FAST.y + ARROW_HEAD}`}
    fill="none" stroke="var(--series-1)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
  />
  <text x={LABEL_X} y={RUN_FAST.labelY} class="fig-label" fill="var(--series-1)">The speed you raise it to</text>

  <!-- 서 있는 시간 — 위젯 막대와 같은 빗금 -->
  <rect x={RAIL_X} y={STOP_Y} width={STOP_W} height={STOP_H} fill="url(#setup-hatch)" stroke="var(--graphite-soft)" stroke-width="1" />
  <text x={STOP_TEXT_X} y={STOP_TEXT_Y} class="fig-label" fill="var(--graphite)">Minutes stuck not moving</text>
  <text x={STOP_NOTE_X} y={STOP_TEXT_Y} class="fig-label-dim" fill="var(--graphite-soft)">· same on both runs</text>
</svg>
