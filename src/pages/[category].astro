---
import Base from "@layouts/Base.astro";
import Art from "@components/Art.astro";
import FeatureCard from "@components/FeatureCard.astro";
import ToolCard from "@components/ToolCard.astro";
import { CATEGORIES, tools_read_latest_day, tools_read_published } from "@data/tools.js";
import { INTROS } from "@data/category-intros.js";

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.key }, props: { category: c } }));
}

const { category } = Astro.props;
const intro = INTROS[category.key];
const tools = tools_read_published(category.key);
// 맨 위 그림 아래에 가장 최근 글을 크게, 나머지는 격자로. 도입글은 그 아래로 내린다 —
// 첫 화면이 글 벽이면 아무것도 읽히지 않는다.
const { date: newestDate, newest, earlier } = tools_read_latest_day(category.key);
/** 첫 화면 칩의 도구 개수 문구. 하나면 단수. */
const TOOL_COUNT_MIN_FOR_PLURAL = 2;
const tool_count_text = (n) => `${n} ${n >= TOOL_COUNT_MIN_FOR_PLURAL ? "tools" : "tool"}`;

// 이 카테고리가 아직 비었을 때 내보낼 곳. **막다른 골목을 만들지 않는다** —
// 지금 이 페이지의 본문 내부 링크는 브레드크럼의 `/` 하나뿐이다.
// 도구가 차면 `tools.length > 0`이 되어 이 분기 자체가 사라진다.
const elsewhere = tools.length > 0 ? [] : tools_read_published().slice(0, 3);

// 이 문장은 바로 아래 그리드의 개수를 약속한다 — 카드가 하나인데 "the tools"라고
// 쓰면 거짓이다. `category_link_text`와 같은 규율이다: 개수에서 문장을 만든다.
const ELSEWHERE_MIN_FOR_PLURAL_TEXT = 2;
const elsewhere_text = (n) =>
  n >= ELSEWHERE_MIN_FOR_PLURAL_TEXT
    ? "The writing above is this section. Below are the tools running on the site today, from wherever they sit."
    : "The writing above is this section. Below is the one tool running on the site today, from wherever it sits.";
const otherSections = CATEGORIES.filter(
  (c) => c.key !== category.key && tools_read_published(c.key).length > 0,
);

// "All X tools"는 집합을 약속한다 — 그 구역에 발행된 도구가 하나면 거짓이다.
// `RelatedTools.astro`가 쓰는 것과 같은 규칙이어야 한다 (같은 링크를 두 가지로
// 설명하면 안 된다). 두 파일이 같은 숫자를 쓴다.
const CATEGORY_MIN_FOR_PLURAL_LINK = 2;
const category_link_text = (c) =>
  tools_read_published(c.key).length >= CATEGORY_MIN_FOR_PLURAL_LINK
    ? `All ${c.name} tools →`
    : `The ${c.name} section →`;
---

<Base title={category.name} description={intro.description} category={category.key} wide>
  <section class="hero-panel">
    <div class="hero-panel-text">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">›</span> {category.name}
      </nav>
      <p class="kicker">Section</p>
      <h1>{category.name}</h1>
      <p class="hero-panel-sub">{intro.description}</p>
      {tools.length > 0 && <p class="hero-count">{tool_count_text(tools.length)}</p>}
    </div>
    <Art name={category.key} />
  </section>

  {
    newest.length > 0 && (
      <section class="home-block" aria-labelledby="cat-newest-title">
        <div class="section-head">
          <p class="kicker">Newest</p>
          <h2 id="cat-newest-title">Published {newestDate}</h2>
        </div>
        <div class="feature-stack">
          {newest.map((tool) => <FeatureCard tool={tool} />)}
        </div>
      </section>
    )
  }

  {
    earlier.length > 0 && (
      <section class="home-block" aria-labelledby="cat-earlier-title">
        <div class="section-head">
          <h2 id="cat-earlier-title">Earlier</h2>
        </div>
        <div class="tool-grid">
          {earlier.map((tool) => (
            <ToolCard tool={tool} heading="h3" showCategory={false} />
          ))}
        </div>
      </section>
    )
  }

  <section class="home-block prose-col" aria-labelledby="cat-about-title">
    <div class="section-head">
      <p class="kicker">About this section</p>
      <h2 id="cat-about-title">About the {category.name} section</h2>
    </div>
    {intro.paragraphs.map((text) => <p>{text}</p>)}
  </section>

  {
    elsewhere.length > 0 && (
      <>
        <h2>Finished elsewhere on the site</h2>
        <p>{elsewhere_text(elsewhere.length)}</p>
        <div class="tool-grid">
          {elsewhere.map((tool) => (
            <ToolCard tool={tool} heading="h3" />
          ))}
        </div>
        {otherSections.length > 0 && (
          <p class="note">
            {otherSections.map((c, i) => (
              <>
                {i > 0 && " · "}
                <a href={c.href}>{category_link_text(c)}</a>
              </>
            ))}
          </p>
        )}
      </>
    )
  }
</Base>
