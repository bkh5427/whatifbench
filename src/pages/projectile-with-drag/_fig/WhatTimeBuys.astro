---
/*
  ** 이 파일이 `---`로 시작하는 이유 ** — C2PA 전송 사고 방지 (규약 §5).

  도해 2 — **메커니즘**. 반전 절에 놓인다.
  위젯이 그리는 것은 ① 높이 대 거리 ② 사거리 대 발사각이다.
  이 그림은 **땅을 따라가는 속력 대 시간**을 그린다 — 위젯에 없는 축이고,
  그 아래 넓이가 곧 사거리다. 각을 올리면 체공시간이 늘지만,
  늘어난 시간은 곡선의 꼬리 쪽에 붙는다. 공기가 없으면 꼬리도 처음과 같은 높이라
  온전한 한 덩이가 더해지고, 공기가 있으면 얇은 조각만 더해진다.
  그래서 최적각이 45°보다 아래로 내려간다.

  색만으로 말하지 않는다 — 두 덩이에 글자를 각각 붙인다.
*/
const W = 420;
const H = 486;

const PLOT_L = 52;
const SPLIT_X = 300;       // 낮은 각이 착지하는 자리
const PLOT_R = 356;        // 높은 각이 착지하는 자리

const TOP_A = 66;
const BASE_A = 190;
const LINE_A = 90;         // 공기 없음 — 처음부터 끝까지 같은 높이

const TOP_B = 264;
const BASE_B = 395;
const START_B = 292;       // 공기 있음 — 여기서 시작해 계속 내려간다
const CURVE_B = "C 130,332 225,360 300,368";
const END_B = 374;

const BRACKET_Y = 204;
const TITLE_Y = 24;
const SUB_A_Y = 52;
const SUB_B_Y = 250;
const FOOT_Y = [420, 442, 468];
---
<svg
  class="fig-svg"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label="Two stacked panels. Both plot the speed the ball is making along the ground against the time it spends in the air, and in both the shaded area under the line is the distance travelled. The top panel is the airless case: the line is flat, so the speed along the ground never drops. A dashed vertical line marks where a lower launch angle would land, and the band of extra flight time to the right of it is shaded as a full-height slab, labelled full slab. The bottom panel is the case with air: the line starts at the same height and falls steadily, so by the end the speed along the ground is much lower. The same band of extra flight time to the right of the dashed line is a smaller strip under the fallen curve, labelled smaller strip. The figure's point is that the extra time bought by a higher launch angle is worth a full slab without air and less with it."
>
  <text x={W / 2} y={TITLE_Y} class="fig-label" fill="var(--graphite)" text-anchor="middle">
    what more time in the air buys
  </text>

  <text x={PLOT_L} y={SUB_A_Y} class="fig-label" fill="var(--graphite)">no air — the speed holds</text>

  <rect x={PLOT_L} y={LINE_A} width={SPLIT_X - PLOT_L} height={BASE_A - LINE_A} fill="var(--steel-200)" />
  <rect x={SPLIT_X} y={LINE_A} width={PLOT_R - SPLIT_X} height={BASE_A - LINE_A} fill="var(--steel-400)" />
  <line x1={PLOT_L} y1={LINE_A} x2={PLOT_R} y2={LINE_A} stroke="var(--graphite)" stroke-width="2.4" />
  <line x1={SPLIT_X} y1={TOP_A} x2={SPLIT_X} y2={BASE_A} stroke="var(--graphite-soft)" stroke-width="1.4" stroke-dasharray="3 3" />
  <line x1={PLOT_L} y1={TOP_A} x2={PLOT_L} y2={BASE_A} stroke="var(--graphite)" stroke-width="1.4" />
  <line x1={PLOT_L} y1={BASE_A} x2={PLOT_R + 10} y2={BASE_A} stroke="var(--graphite)" stroke-width="1.4" />

  <text x={(PLOT_L + SPLIT_X) / 2} y={LINE_A + 40} class="fig-label-dim" text-anchor="middle">distance = area</text>
  <text x={(SPLIT_X + PLOT_R) / 2} y={LINE_A + 68} class="fig-label-dim" text-anchor="middle">full</text>
  <text x={(SPLIT_X + PLOT_R) / 2} y={LINE_A + 86} class="fig-label-dim" text-anchor="middle">slab</text>

  <line x1={SPLIT_X} y1={BRACKET_Y} x2={PLOT_R} y2={BRACKET_Y} stroke="var(--graphite-soft)" stroke-width="1.4" />
  <line x1={SPLIT_X} y1={BRACKET_Y - 4} x2={SPLIT_X} y2={BRACKET_Y + 4} stroke="var(--graphite-soft)" stroke-width="1.4" />
  <line x1={PLOT_R} y1={BRACKET_Y - 4} x2={PLOT_R} y2={BRACKET_Y + 4} stroke="var(--graphite-soft)" stroke-width="1.4" />
  <text x={SPLIT_X - 8} y={BRACKET_Y + 5} class="fig-label-dim" text-anchor="end">extra time</text>

  <text x={PLOT_L} y={SUB_B_Y} class="fig-label" fill="var(--graphite)">with air — the speed falls</text>

  <path
    d={`M ${PLOT_L},${START_B} ${CURVE_B} L ${PLOT_R},${END_B} L ${PLOT_R},${BASE_B} L ${PLOT_L},${BASE_B} Z`}
    fill="var(--steel-200)"
  />
  <path
    d={`M ${SPLIT_X},368 L ${PLOT_R},${END_B} L ${PLOT_R},${BASE_B} L ${SPLIT_X},${BASE_B} Z`}
    fill="var(--steel-400)"
  />
  <path
    d={`M ${PLOT_L},${START_B} ${CURVE_B} L ${PLOT_R},${END_B}`}
    fill="none" stroke="var(--graphite)" stroke-width="2.4"
  />
  <line x1={SPLIT_X} y1={TOP_B} x2={SPLIT_X} y2={BASE_B} stroke="var(--graphite-soft)" stroke-width="1.4" stroke-dasharray="3 3" />
  <line x1={PLOT_L} y1={TOP_B} x2={PLOT_L} y2={BASE_B} stroke="var(--graphite)" stroke-width="1.4" />
  <line x1={PLOT_L} y1={BASE_B} x2={PLOT_R + 10} y2={BASE_B} stroke="var(--graphite)" stroke-width="1.4" />

  <text x={(PLOT_L + SPLIT_X) / 2} y={BASE_B - 14} class="fig-label-dim" text-anchor="middle">distance = area</text>
  <line x1={(SPLIT_X + PLOT_R) / 2} y1={END_B - 28} x2={(SPLIT_X + PLOT_R) / 2} y2={BASE_B - 8}
        stroke="var(--graphite-soft)" stroke-width="1.2" />
  <text x={PLOT_R} y={END_B - 34} class="fig-label-dim" text-anchor="end">smaller strip</text>

  <text x={W / 2} y={FOOT_Y[0]} class="fig-label-dim" text-anchor="middle">across: time in the air</text>
  <text x={W / 2} y={FOOT_Y[1]} class="fig-label-dim" text-anchor="middle">up: speed along the ground</text>
  <text x={W / 2} y={FOOT_Y[2]} class="fig-label" fill="var(--graphite)" text-anchor="middle">
    with air the extra time buys less
  </text>
</svg>
