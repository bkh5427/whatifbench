---
/*
  ** 이 파일이 `---`로 시작하는 이유 **
  `<svg`로 시작하는 `.astro`는 PC로 보낼 때 콘텐츠 서명(C2PA)이 붙어
  **+7,774바이트가 끼어들며 파일이 깨진다.** 규약 §5 제작 표준의 조항이다.

  도해 1 · **설정**. 무엇을 재는 상황인가만 그린다 — 숫자 결과는 하나도 없다.
  자리는 **위젯 앞**(규약 §5 표, §5.5 S7): 규칙을 모르면 슬라이더를 만질 수 없다.
  이 그림이 미리 밝히는 규칙은 둘이다 — 경로는 직선 하나이고, 빼는 항은
  거리 하나와 벽 하나씩이다.

  ** 왜 세로가 150인가 (2026-09-20) **
  이 자리는 규약 §1.5의 "가로형 짧은 띠"다. 폰(390×844) 실측에서 위젯 상단
  깊이의 차이는 **전부 이 한 장**에서 나왔다 — 덱·H1·바이라인·리드는 열 편이
  거의 같았다. 처음 그린 240짜리는 위젯을 아래로 밀었고 게이트가 그것을 잡는다.
  줄인 방법은 둘이다.
    ① 뺄셈 설명 두 줄을 **한 줄**로 줄였다.
    ② 거리 괄호의 라벨을 선 **위**가 아니라 **선 안**에 넣었다 — 치수선 방식이라
       글자 한 줄분(약 20)이 통째로 사라진다.
  경로 하나·벽 두 장·뺄셈은 그대로다. `variant="lede"`는 붙이지 않는다 —
  붙이면 게이트가 도해를 두 장으로 세어 막는다(이 편은 도해가 셋뿐이다).

  좌표는 전부 상수로 올린다(규약 §5). 색은 global.css 토큰만 쓴다.
*/
const W = 420;
const H = 150;
const MID_X = W / 2;

/** 전파 경로가 지나는 높이. 공유기·기기·벽이 전부 이 선에 맞춰 선다. */
const PATH_Y = 54;

const ROUTER_X = 16;
const ROUTER_Y = 38;
const ROUTER_W = 40;
const ROUTER_H = 32;
const ROUTER_MID = ROUTER_X + ROUTER_W / 2;
const ANTENNA_TIP_Y = 14;

const DEVICE_X = 376;
const DEVICE_Y = 32;
const DEVICE_W = 28;
const DEVICE_H = 44;
const DEVICE_MID = DEVICE_X + DEVICE_W / 2;

/** 벽 두 장. 같은 두께로 그린다 — 두께는 슬라이더의 일이지 이 그림의 일이 아니다. */
const SLAB_Y = 26;
const SLAB_H = 56;
const SLAB_W = 12;
const SLAB_ONE_X = 150;
const SLAB_TWO_X = 250;
const SLAB_LABEL_Y = 20;

const PATH_FROM = ROUTER_X + ROUTER_W + 2;
const PATH_TO = DEVICE_X - 4;

const ROW_LABEL_Y = 96;

/**
 * 거리 치수선. 라벨을 선 위에 얹지 않고 **선을 끊어 그 사이에** 둔다 —
 * 무엇을 재는 선인지 말하면서 글자 한 줄분의 세로를 쓰지 않는다.
 */
const SPAN_Y = 116;
const SPAN_TICK = 5;
const SPAN_GAP_LEFT = 174;
const SPAN_GAP_RIGHT = 246;
const SPAN_LABEL_Y = SPAN_Y + 5;

const SUM_Y = 142;
---
<svg
  class="fig-svg"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label="The situation this model measures, drawn as one horizontal band. A router on the left, shown as a small box with two antennas, sends one straight arrow to a device on the right, shown as a small upright box. Two identical wall slabs stand across that arrow between them, each a narrow upright rectangle labelled wall. A dimension line underneath runs from the router to the device, with the word distance sitting inside a break in the line. One line at the bottom gives the whole subtraction in words: power out, minus distance, minus each wall, equals signal here. No numbers appear anywhere in the figure."
>
  <!-- 공유기 — 상자 하나와 안테나 두 개. 기하 도형만 쓴다(규약 §5). -->
  <rect
    x={ROUTER_X} y={ROUTER_Y} width={ROUTER_W} height={ROUTER_H} rx="4"
    fill="var(--surface)" stroke="var(--graphite)" stroke-width="2"
  />
  <line x1={ROUTER_X + 9} y1={ROUTER_Y} x2={ROUTER_X + 5} y2={ANTENNA_TIP_Y} stroke="var(--graphite)" stroke-width="2" stroke-linecap="round" />
  <line x1={ROUTER_X + ROUTER_W - 9} y1={ROUTER_Y} x2={ROUTER_X + ROUTER_W - 5} y2={ANTENNA_TIP_Y} stroke="var(--graphite)" stroke-width="2" stroke-linecap="round" />
  <circle cx={ROUTER_X + 5} cy={ANTENNA_TIP_Y} r="2.5" fill="var(--graphite)" />
  <circle cx={ROUTER_X + ROUTER_W - 5} cy={ANTENNA_TIP_Y} r="2.5" fill="var(--graphite)" />

  <!-- 기기 — 세로 상자와 화면 -->
  <rect
    x={DEVICE_X} y={DEVICE_Y} width={DEVICE_W} height={DEVICE_H} rx="5"
    fill="var(--surface)" stroke="var(--graphite)" stroke-width="2"
  />
  <rect
    x={DEVICE_X + 5} y={DEVICE_Y + 6} width={DEVICE_W - 10} height={DEVICE_H - 16} rx="2"
    fill="var(--paper-sunk)" stroke="var(--rule)" stroke-width="1"
  />

  <!-- 경로 — 직선 하나. 굽지도 튕기지도 않는다는 것이 이 그림의 규칙이다. -->
  <line x1={PATH_FROM} y1={PATH_Y} x2={PATH_TO} y2={PATH_Y} stroke="var(--graphite)" stroke-width="2" />
  <path
    d={`M${PATH_TO - 9},${PATH_Y - 5} L${PATH_TO},${PATH_Y} L${PATH_TO - 9},${PATH_Y + 5}`}
    fill="none" stroke="var(--graphite)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  />

  <!-- 벽 두 장 -->
  <rect x={SLAB_ONE_X} y={SLAB_Y} width={SLAB_W} height={SLAB_H} fill="var(--paper-sunk)" stroke="var(--graphite)" stroke-width="2" />
  <rect x={SLAB_TWO_X} y={SLAB_Y} width={SLAB_W} height={SLAB_H} fill="var(--paper-sunk)" stroke="var(--graphite)" stroke-width="2" />
  <text x={SLAB_ONE_X + SLAB_W / 2} y={SLAB_LABEL_Y} class="fig-label" text-anchor="middle">wall</text>
  <text x={SLAB_TWO_X + SLAB_W / 2} y={SLAB_LABEL_Y} class="fig-label" text-anchor="middle">wall</text>

  <text x={ROUTER_MID} y={ROW_LABEL_Y} class="fig-label" text-anchor="middle">router</text>
  <text x={DEVICE_MID} y={ROW_LABEL_Y} class="fig-label" text-anchor="middle">device</text>

  <!-- 거리 치수선 — 라벨이 선을 끊고 그 안에 앉는다 -->
  <line x1={ROUTER_MID} y1={SPAN_Y} x2={SPAN_GAP_LEFT} y2={SPAN_Y} stroke="var(--graphite-soft)" stroke-width="1.5" />
  <line x1={SPAN_GAP_RIGHT} y1={SPAN_Y} x2={DEVICE_MID} y2={SPAN_Y} stroke="var(--graphite-soft)" stroke-width="1.5" />
  <line x1={ROUTER_MID} y1={SPAN_Y - SPAN_TICK} x2={ROUTER_MID} y2={SPAN_Y + SPAN_TICK} stroke="var(--graphite-soft)" stroke-width="1.5" />
  <line x1={DEVICE_MID} y1={SPAN_Y - SPAN_TICK} x2={DEVICE_MID} y2={SPAN_Y + SPAN_TICK} stroke="var(--graphite-soft)" stroke-width="1.5" />
  <text x={MID_X} y={SPAN_LABEL_Y} class="fig-label" text-anchor="middle">distance</text>

  <!-- 뺄셈을 말로. 이 페이지 전체가 이 한 줄이다. -->
  <text x={MID_X} y={SUM_Y} class="fig-label" text-anchor="middle">power out − distance − each wall = signal here</text>
</svg>
