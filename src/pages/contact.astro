---
import Base from "@layouts/Base.astro";
import { tools_read_published } from "@data/tools.js";

const EMAIL = "contact@whatifbench.com";

// 본문에서 나가는 길. 헤더·푸터로만 나갈 수 있으면 이 페이지는 막다른 골목이다.
// 도구 이름을 하드코딩하지 않는다 — tools.js가 진실 원본이고, 발행된 것이
// 하나도 없으면 그 절이 통째로 사라져야 한다 (없는 페이지를 가리키지 않는다).
const named = tools_read_published()[0] ?? null;
---

<Base
  title="Contact"
  description="How to reach whatifbench about corrections, questions, or requests for a specific calculator."
>
  <h1>Contact</h1>

  <p>
    Email is the only channel. I read everything, though replies can take a few
    days.
  </p>

  <p class="contact-address">
    <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
  </p>

  <h2>Things worth emailing about</h2>

  <ul>
    <li>
      <strong>Corrections.</strong> A wrong coefficient, a broken slider, a
      derivation that does not hold. Include the page and what you expected
      instead.
    </li>
    <li>
      <strong>Requests.</strong> A calculation you keep doing by hand that would
      be better as a tool.
    </li>
    <li>
      <strong>Questions about the models.</strong> Why a particular assumption
      is used, or where a coefficient comes from.
    </li>
  </ul>

  <p>
    It helps to name the page you mean. Each tool page states the model it runs,
    what that model assumes and what it leaves out{
      named && (
        <>
          , as <a href={`/${named.slug}`}>{named.name}</a> does
        </>
      )
    }, so the assumption behind a number is already written down where you can
    point at it.
  </p>

  <h2>What I can't help with</h2>

  <p>
    I can't do your homework, and I can't tell you whether a number is safe to
    act on. If something you're building depends on the answer, ask someone who
    can be held to it.
  </p>

  <p class="note">
    It's a plain inbox, so don't send me anything you'd mind other people seeing.
  </p>
</Base>
