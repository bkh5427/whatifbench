---
// 서체는 자체 호스팅한다. 구글 폰트는 왕복이 두 번이라(CSS 한 번, 파일 한 번)
// 실측에서 첫 페인트를 300~400ms 늦췄다. 같은 오리진에서 내보내면 그 왕복이 사라진다.
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/500.css";
import "@fontsource/barlow/600.css";
import "@fontsource/barlow/400-italic.css";
import "@fontsource/barlow-condensed/500.css";
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";

import "../styles/global.css";

import { CATEGORIES, tools_read_published } from "../data/tools.js";
import { SITE_NAME, SITE_TAGLINE } from "../data/site.js";
import { existsSync } from "node:fs";
import { join } from "node:path";

// category: 도구 페이지가 자기 카테고리를 알려주는 유일한 자리.
// URL이 평면(/monty-hall-n-doors)이라 경로에서 유추할 수 없다.
//
// crumbLabel: 구조화 데이터의 마지막 항목에 쓸 이름. **화면 브레드크럼과 같은
// 문자열이어야 한다** (Google 구조화 데이터 정책: 마크업은 화면에 보이는 것과
// 일치해야 한다). 넘기지 않으면 `title`(긴 SEO 제목)로 떨어지는데, 그것은
// 화면의 짧은 이름과 다르다 — 도구 페이지는 반드시 넘긴다.
const {
  title,
  description,
  wide = false,
  category = null,
  crumbTool = false,
  crumbLabel = null,
  noindex = false,
} = Astro.props;

// 도구 페이지에만 브레드크럼 구조화 데이터를 붙인다.
const crumb = crumbTool ? CATEGORIES.find((c) => c.key === category) : null;

/** 스킵 링크가 가리키는 자리. `<main>`의 id와 링크 href가 이 한 값에서 나온다. */
const MAIN_ID = "main";
const fullTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const wrapClass = wide ? "wrap-wide" : "wrap";

/* 공유 카드. 링크를 붙였을 때 그림 없는 맨 줄로 나가지 않게 한다.
   위젯은 캔버스라 JS가 돌아야 보이고, 링크 미리보기는 JS를 돌리지 않는다.
   파일은 `scripts/build-og.mjs`가 만들어 `public/og/`에 둔다 — 없으면 기본 카드로,
   기본 카드도 없으면 태그 자체를 내지 않는다. 404를 가리키는 태그보다 없는 편이 낫다. */
const OG_DIR = "og";
const OG_DEFAULT_SLUG = "default";
const OG_WIDTH_PX = "1200";
const OG_HEIGHT_PX = "630";
const og_read_path = (slug) =>
  slug && existsSync(join(process.cwd(), "public", OG_DIR, `${slug}.png`)) ? `/${OG_DIR}/${slug}.png` : null;
const ogPath = og_read_path(path.replace(/^\/+|\/+$/g, "")) ?? og_read_path(OG_DEFAULT_SLUG);
const ogImage = ogPath ? new URL(ogPath, Astro.site) : null;
/** `<details>`의 id. 바깥 클릭·Esc 스크립트가 이 id 하나로 찾는다. */
const NAV_TOOLS_ID = "nav-tools";
/** 헤더 "Tools" 버튼 자체를 현재 위치로 표시할지. 도구·카테고리 페이지 어디서든
    `category`가 채워진다 — 그 페이지가 어느 카테고리에도 속하지 않는 /about 등에서는
    비어 있다. */
const inTools = category !== null;
/** 홈에서 최신 글 목록이 시작하는 자리(대표 카드 절)의 id. 머리말 Latest·패널 All tools가 여기로 간다 (`pages/index.astro`의 LATEST_ID). */
const LATEST_ANCHOR = "latest";
/** 패널 열 수 = 열린 카테고리 수, 상한 넷. 하나면 좁은 드롭다운, 넷이면 헤더 폭 전체. */
const NAV_COLUMNS_MAX = 4;
const navColumns = Math.min(Math.max(CATEGORIES.length, 1), NAV_COLUMNS_MAX);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      /* noindex: 이 주소에 페이지가 없는 화면(404)용. 그 화면은 없는 주소 **전부**에
         나오므로 canonical이나 og:url을 달면 "그 내용은 /404에 있는 진짜 페이지"라고
         크롤러와 링크 미리보기에 말하는 셈이 된다 — 화면에 적힌 말과 반대다. */
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      /* URL이 평면이라 이 도구가 어느 카테고리인지 알려줄 자리가 여기밖에 없다. */
      crumb && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            itemListElement: [
              { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
              { "@type": "ListItem", position: 2, name: crumb.name, item: new URL(crumb.href, Astro.site).href },
              { "@type": "ListItem", position: 3, name: crumbLabel ?? title },
            ],
          })}
        />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content={OG_WIDTH_PX} />
          <meta property="og:image:height" content={OG_HEIGHT_PX} />
          <meta name="twitter:image" content={ogImage} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
  </head>

  <body>
    {/* 모든 페이지가 같은 헤더(로고·Tools·About, 열면 카테고리·도구 링크까지)를
        반복한다. 키보드·스크린리더 사용자가 그것을 건너뛸 길이 필요하다
        (WCAG 2.4.1 Bypass Blocks, Level A).
        평소에는 화면 위로 밀려 있고 포커스를 받으면 내려온다 —
        `display:none`으로 숨기면 포커스를 못 받아 아무 일도 하지 않는다. */}
    <a class="skip-link" href={`#${MAIN_ID}`}>Skip to content</a>

    <header class="site-head">
      <div class="wrap-wide site-head-inner">
        <a class="brand" href="/">
          <svg class="brand-logo" width="32" height="20" viewBox="0 0 32 20" aria-hidden="true" focusable="false">
            <rect x="0" y="8" width="10.6" height="5" rx="1.5" style="fill:var(--steel-300)" />
            <rect x="10.6" y="8" width="10.7" height="5" style="fill:var(--steel-600)" />
            <rect x="21.3" y="8" width="10.7" height="5" rx="1.5" style="fill:var(--steel-900)" />
            <circle cx="21.3" cy="10.5" r="5.5" style="fill:var(--paper); stroke:var(--graphite); stroke-width:2" />
          </svg>
          <span class="brand-text">
            <span class="brand-name">{SITE_NAME}</span>{" "}
            <span class="brand-tagline">{SITE_TAGLINE}</span>
          </span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {/* 카테고리가 5개가 되면 평면 나열이 360px에서 두 줄로 깨진다
              (`tools.js`의 `CATEGORY_MAX_BEFORE_HEADER_CHANGE`). 그 계획대로
              로고 + Tools + About 세 항목으로 줄이고, 카테고리·도구는 그 안의
              패널 하나에 담는다. `<details>`는 JS 0줄로 탭·클릭·키보드·
              스크린리더가 전부 동작한다 — 바깥 클릭·Esc만 아래 스크립트가 보탠다. */}
          <details class="nav-tools" id={NAV_TOOLS_ID}>
            <summary class="nav-tools-summary" aria-current={inTools ? "true" : undefined}>
              Tools
              <svg class="nav-caret" width="10" height="7" viewBox="0 0 10 7" aria-hidden="true" focusable="false">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="nav-panel" style={`--nav-cols:${navColumns}`}>
              <div class="nav-panel-top">
                <div>
                  <p class="kicker nav-panel-eyebrow">Browse the tools</p>
                  <p class="nav-panel-title">Tools by section</p>
                </div>
                <a class="nav-panel-all" href={`/#${LATEST_ANCHOR}`}>All tools →</a>
              </div>
              <div class="nav-panel-inner">
                {
                  CATEGORIES.map((c) => {
                    const catTools = tools_read_published(c.key);
                    return (
                      <div class="nav-panel-group">
                        <a
                          class="nav-panel-heading"
                          href={c.href}
                          aria-current={path === c.href ? "page" : category === c.key ? "true" : undefined}
                        >
                          {c.name}
                        </a>
                        {catTools.length > 0 && (
                          <ul class="nav-panel-list">
                            {catTools.map((t) => (
                              <li>
                                <a
                                  href={`/${t.slug}`}
                                  aria-current={path === `/${t.slug}` ? "page" : undefined}
                                >
                                  {t.name}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    );
                  })
                }
              </div>
              <p class="nav-panel-note">Only sections with published tools are listed.</p>
            </div>
          </details>
          <a class="nav-latest" href={`/#${LATEST_ANCHOR}`}>Latest</a>
          <a href="/about" aria-current={path === "/about" ? "page" : undefined}>About</a>
        </nav>
      </div>
      <div class="regime-band" aria-hidden="true"><span></span><span></span><span></span></div>
    </header>

    {/* 바깥 클릭·Esc로 닫기만 보탠다 — 열고 닫는 것 자체는 `<details>` 네이티브
        동작이라 이 스크립트가 안 돌아도(차단·실패) 메뉴는 그대로 동작한다. */}
    <script>
      const navTools = document.getElementById("nav-tools");
      if (navTools instanceof HTMLDetailsElement) {
        document.addEventListener("click", (event) => {
          if (navTools.open && !navTools.contains(event.target)) {
            navTools.open = false;
          }
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && navTools.open) {
            navTools.open = false;
            navTools.querySelector("summary")?.focus();
          }
        });
      }
    </script>

    {/* tabindex="-1": 이것이 없으면 일부 브라우저에서 스킵 링크가 스크롤만 하고
        포커스는 헤더에 남는다 — 다음 Tab이 다시 네비게이션으로 돌아간다. */}
    <main id={MAIN_ID} class={wrapClass} tabindex="-1">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap-wide">
        <div class="foot-groups">
          <div class="foot-brand">
            <p class="foot-name">{SITE_NAME}</p>
            <p class="foot-tagline">{SITE_TAGLINE}</p>
          </div>
          <div>
            <p class="foot-label">Tools</p>
            {CATEGORIES.map((c) => <a href={c.href}>{c.name}</a>)}
          </div>
          <div>
            <p class="foot-label">Site</p>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="/privacy">Privacy</a>
          </div>
        </div>
        <p class="foot-note">
          Made by one person, for fun. Check anything you're going to act on.
        </p>
      </div>
    </footer>
  </body>
</html>
