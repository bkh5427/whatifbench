---
// 글마다 한 장의 썸네일. 원본은 그 글의 폴더에 있는 `_thumb.svg`다 —
// 공유 카드(`scripts/build-og.mjs`)도 같은 파일을 읽는다. 그림은 한 벌뿐이다.
//
// 그림은 **장식이다** (aria-hidden). 카드의 이름·설명이 이미 같은 것을 말하고,
// 그림에는 글자도 숫자도 없다 — 검사할 주장을 그림에 싣지 않는다.
// 색은 `global.css`의 토큰을 var()로 읽는다. 사이트 색을 바꾸면 그림도 따라간다.
import { thumb_read_markup } from "./thumb.js";

const { slug } = Astro.props;
const markup = thumb_read_markup(slug);
---

{markup && <div class="thumb" set:html={markup} />}
