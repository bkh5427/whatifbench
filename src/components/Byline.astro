---
// 도구 페이지 상단 바이라인. 누가 썼고, 모델 등급이 무엇이고, 언제 마지막으로
// 사람이 끝까지 읽었는지를 **본문을 읽기 전에** 보이게 한다 (E-E-A-T 신호).
//
// 값은 전부 tools.js에서 읽는다. 페이지에 날짜를 하드코딩하면 진실 원본이
// 둘이 되고, 둘은 반드시 갈라진다.
import Avatar from "./Avatar.astro";
import { tools_read_one } from "../data/tools.js";

const GRADE_MEANING = {
  A: "arithmetic and probability — this one is either right or wrong",
  B: "a standard formula with published coefficients",
};
const AVATAR_SIZE_BYLINE = 34;

const { slug } = Astro.props;
const tool = tools_read_one(slug);
if (!tool) throw new Error(`바이라인이 모르는 도구다: ${slug}`);

// 검수일이 없으면 줄 자체를 내지 않는다. 예전에는 "Last reviewed: TODO"를 찍었는데,
// 그건 독자에게 내부 표식을 보여주는 것이고 산출물에 미완성 표식을 남겨
// 푸시 게이트도 함께 걸렸다. 검수 누락은 tools.js의 updated 빈 값으로 이미 잡힌다.
const reviewed = tool.updated ?? null;
---

<div class="byline">
  <Avatar size={AVATAR_SIZE_BYLINE} />
  <p class="byline-text">
    <a href="/about">Planimeter</a> · Model grade {tool.grade}<span
      class="byline-grade-detail"><span class="byline-sep">{" — "}</span>
      <span class="byline-grade">{GRADE_MEANING[tool.grade]}</span></span>
    {reviewed && (<span class="byline-dim">{"\u00a0· Reviewed "}{reviewed}</span>)}
  </p>
</div>
