{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check-publish.mjs",
    "check:full": "npm run build && npm run check",
    "pages:build": "npm run check:full",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "push": "git push"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.2.10"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "vitest": "^5.0.0"
  }
}
